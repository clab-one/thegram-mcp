{
	"name": "thegram-memory",
	"version": "3.0.7",
	"description": "Thegram Cloud project memory for coding agents through scoped API keys",
	"private": true,
	"type": "module",
	"license": "UNLICENSED",
	"repository": "github:clab-one/thegram-mcp",
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"thegram-memory": "dist/thegram-memory.mjs"
	},
	"exports": {
		".": "./src/opencode.ts"
	},
	"omp": {
		"extensions": ["./src/omp.ts"]
	},
	"scripts": {
		"bundle": "bun build src/cli.ts --target=node --format=esm --outfile=dist/thegram-memory.mjs --banner='#!/usr/bin/env node'"
	}
}
